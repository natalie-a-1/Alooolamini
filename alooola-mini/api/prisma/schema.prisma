// Database schema and Prisma models.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  owner
  member
  viewer

  @@map("member_role")
}

enum MemberStatus {
  pending
  accepted

  @@map("member_status")
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked

  @@map("invite_status")
}

enum RiskTolerance {
  conservative
  moderate
  aggressive

  @@map("risk_tolerance")
}

enum TxnType {
  spend
  receive

  @@map("txn_type")
}

enum ReferralEventType {
  click
  signup
  complete

  @@map("referral_event_type")
}

enum AssistantSender {
  user
  assistant
  system

  @@map("assistant_sender")
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique
  name                 String?
  referredByUserId     String?               @map("referred_by_user_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  auth                 UserAuth?
  profile              UserProfile?
  refreshTokens        RefreshToken[]
  passwordResets       PasswordReset[]
  emailVerifications   EmailVerification[]
  householdMembers     HouseholdMember[]
  transactions         Transaction[]         @relation("TransactionAttributedUser")
  transfersFrom        Transfer[]            @relation("TransferFromUser")
  transfersTo          Transfer[]            @relation("TransferToUser")
  fundingSources       FundingSource[]
  rewardAccount        RewardAccount?
  rewardEvents         RewardEvent[]
  goalSelections       UserGoalSelection[]
  investmentProfile    UserInvestmentProfile?
  portfolioPositions   UserPortfolioPosition[]
  portfolioSnapshots   PortfolioSnapshot[]
  portfolioHoldings    PortfolioPosition[]
  assistantThreads     AssistantThread[]
  advisorSlotsHeld     AdvisorSlot[]         @relation("AdvisorSlotHeldBy")
  advisorAppointments  AdvisorAppointment[]
  referrals            Referral[]            @relation("ReferralOwner")
  referredBy           User?                 @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referredUsers        User[]                @relation("UserReferrals")
  devices              UserDevice[]
  notifications        Notification[]
  watchlistItems       WatchlistItem[]

  @@map("users")
}

model UserAuth {
  userId             String   @id @map("user_id") @db.Uuid
  passwordHash       String   @map("password_hash")
  passwordUpdatedAt  DateTime @map("password_updated_at") @db.Timestamptz(6)
  mfaEnabled         Boolean  @default(false) @map("mfa_enabled")
  mfaSecret          String?  @map("mfa_secret")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id])

  @@map("user_auth")
}

model RefreshToken {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  tokenHash     String         @map("token_hash")
  userAgent     String?        @map("user_agent")
  ipAddress     String?        @map("ip_address") @db.Inet
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  replacedById  String?        @unique @map("replaced_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User           @relation(fields: [userId], references: [id])
  replacedBy    RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedById], references: [id])
  replaces      RefreshToken?  @relation("RefreshTokenReplacement")

  @@index([userId])
  @@unique([tokenHash])
  @@map("refresh_tokens")
}

model PasswordReset {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@unique([tokenHash])
  @@map("password_resets")
}

model EmailVerification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@unique([tokenHash])
  @@map("email_verifications")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  avatarUrl   String?  @map("avatar_url")
  profession  String?
  memberTier  String?  @map("member_tier")
  memberSince DateTime? @map("member_since") @db.Date
  timezone    String?
  locale      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model Household {
  id                 String                @id @default(uuid()) @db.Uuid
  name               String
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  members            HouseholdMember[]
  invites            Invite[]
  accounts           Account[]
  categories         Category[]
  transactions       Transaction[]
  transfers          Transfer[]
  portfolioPositions UserPortfolioPosition[]
  portfolioSnapshots PortfolioSnapshot[]
  assistantThreads   AssistantThread[]

  @@map("households")
}

model HouseholdMember {
  id          String       @id @default(uuid()) @db.Uuid
  householdId String       @map("household_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  role        MemberRole
  status      MemberStatus
  invitedAt   DateTime?    @map("invited_at") @db.Timestamptz(6)
  joinedAt    DateTime?    @map("joined_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  household   Household    @relation(fields: [householdId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@unique([householdId, userId])
  @@map("household_members")
}

model Invite {
  id          String       @id @default(uuid()) @db.Uuid
  householdId String       @map("household_id") @db.Uuid
  email       String
  token       String       @unique
  status      InviteStatus
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime?    @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  household   Household    @relation(fields: [householdId], references: [id])

  @@index([householdId, email])
  @@map("invites")
}

model Account {
  id           String         @id @default(uuid()) @db.Uuid
  householdId  String         @map("household_id") @db.Uuid
  name         String
  type         String
  institution  String?
  last4        String?        @map("last4")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  household    Household      @relation(fields: [householdId], references: [id])
  transactions Transaction[]
  balance      AccountBalance?

  @@map("accounts")
}

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String?       @map("household_id") @db.Uuid
  name        String
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  household   Household?    @relation(fields: [householdId], references: [id])
  transactions Transaction[]

  @@unique([householdId, name])
  @@map("categories")
}

model Transaction {
  id               String   @id @default(uuid()) @db.Uuid
  householdId      String   @map("household_id") @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  attributedUserId String   @map("attributed_user_id") @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  txnType          TxnType  @map("txn_type")
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @default("USD")
  merchant         String
  txnDate          DateTime @map("txn_date") @db.Date
  note             String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  household        Household @relation(fields: [householdId], references: [id])
  account          Account   @relation(fields: [accountId], references: [id])
  attributedUser   User      @relation("TransactionAttributedUser", fields: [attributedUserId], references: [id])
  category         Category  @relation(fields: [categoryId], references: [id])

  @@index([householdId, txnDate, id])
  @@index([accountId, txnDate])
  @@map("transactions")
}

model AccountBalance {
  accountId        String   @id @map("account_id") @db.Uuid
  availableBalance Decimal  @map("available_balance") @db.Decimal(12, 2)
  currentBalance   Decimal  @map("current_balance") @db.Decimal(12, 2)
  asOf             DateTime @map("as_of") @db.Timestamptz(6)
  account          Account  @relation(fields: [accountId], references: [id])

  @@map("account_balances")
}

model Transfer {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  fromUserId  String   @map("from_user_id") @db.Uuid
  toUserId    String   @map("to_user_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  note        String?
  status      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt    DateTime? @map("posted_at") @db.Timestamptz(6)
  household   Household @relation(fields: [householdId], references: [id])
  fromUser    User      @relation("TransferFromUser", fields: [fromUserId], references: [id])
  toUser      User      @relation("TransferToUser", fields: [toUserId], references: [id])

  @@index([householdId, createdAt])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("transfers")
}

model FundingSource {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String
  providerRef String   @map("provider_ref")
  label       String?
  type        String
  last4       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("funding_sources")
}

model RewardAccount {
  userId         String   @id @map("user_id") @db.Uuid
  balance        Decimal  @db.Decimal(12, 2)
  lifetimeEarned Decimal  @map("lifetime_earned") @db.Decimal(12, 2)
  rewardRatePct  Decimal  @map("reward_rate_pct") @db.Decimal(6, 2)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id])

  @@map("reward_accounts")
}

model RewardEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  eventType  String   @map("event_type")
  sourceType String   @map("source_type")
  sourceId   String?  @map("source_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("reward_events")
}

model GoalOption {
  id         String              @id @default(uuid()) @db.Uuid
  key        String              @unique
  label      String
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  selections UserGoalSelection[]

  @@map("goal_options")
}

model UserGoalSelection {
  userId    String   @map("user_id") @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])
  goal      GoalOption @relation(fields: [goalId], references: [id])

  @@id([userId, goalId])
  @@map("user_goal_selections")
}

model UserInvestmentProfile {
  userId             String        @id @map("user_id") @db.Uuid
  riskTolerance      RiskTolerance @map("risk_tolerance")
  starterAmount      Decimal?      @map("starter_amount") @db.Decimal(12, 2)
  starterAmountCustom Decimal?     @map("starter_amount_custom") @db.Decimal(12, 2)
  goalOtherText      String?       @map("goal_other_text")
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User          @relation(fields: [userId], references: [id])

  @@map("user_investment_profile")
}

model CuratedPortfolio {
  id               String              @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  riskTolerance    RiskTolerance       @map("risk_tolerance")
  oneYearReturnPct Decimal?            @map("one_year_return_pct") @db.Decimal(6, 2)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  holdings         PortfolioHolding[]
  userPositions    UserPortfolioPosition[]
  snapshots        PortfolioSnapshot[]
  positions        PortfolioPosition[]
  watchlistItems   WatchlistItem[]

  @@map("curated_portfolios")
}

model PortfolioHolding {
  id           String          @id @default(uuid()) @db.Uuid
  portfolioId  String          @map("portfolio_id") @db.Uuid
  symbol       String
  weightPct    Decimal         @map("weight_pct") @db.Decimal(6, 2)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  portfolio    CuratedPortfolio @relation(fields: [portfolioId], references: [id])

  @@unique([portfolioId, symbol])
  @@map("portfolio_holdings")
}

model UserPortfolioPosition {
  id             String           @id @default(uuid()) @db.Uuid
  householdId    String           @map("household_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  portfolioId    String           @map("portfolio_id") @db.Uuid
  amountInvested Decimal          @map("amount_invested") @db.Decimal(12, 2)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  household      Household        @relation(fields: [householdId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
  portfolio      CuratedPortfolio @relation(fields: [portfolioId], references: [id])

  @@map("user_portfolio_positions")
}

model PortfolioSnapshot {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  householdId String           @map("household_id") @db.Uuid
  portfolioId String?          @map("portfolio_id") @db.Uuid
  totalValue  Decimal          @map("total_value") @db.Decimal(12, 2)
  gainAmount  Decimal?         @map("gain_amount") @db.Decimal(12, 2)
  gainPercent Decimal?         @map("gain_percent") @db.Decimal(6, 2)
  asOf        DateTime         @map("as_of") @db.Timestamptz(6)
  user        User             @relation(fields: [userId], references: [id])
  household   Household        @relation(fields: [householdId], references: [id])
  portfolio   CuratedPortfolio? @relation(fields: [portfolioId], references: [id])

  @@index([userId, asOf])
  @@map("portfolio_snapshots")
}

model PortfolioPosition {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  portfolioId String           @map("portfolio_id") @db.Uuid
  symbol      String
  quantity    Decimal          @db.Decimal(18, 6)
  costBasis   Decimal?         @map("cost_basis") @db.Decimal(12, 2)
  marketValue Decimal?         @map("market_value") @db.Decimal(12, 2)
  asOf        DateTime         @map("as_of") @db.Timestamptz(6)
  user        User             @relation(fields: [userId], references: [id])
  portfolio   CuratedPortfolio @relation(fields: [portfolioId], references: [id])

  @@unique([userId, portfolioId, symbol, asOf])
  @@map("portfolio_positions")
}

model AssistantThread {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  householdId String?       @map("household_id") @db.Uuid
  title       String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User          @relation(fields: [userId], references: [id])
  household   Household?    @relation(fields: [householdId], references: [id])
  messages    AssistantMessage[]

  @@map("assistant_threads")
}

model AssistantMessage {
  id        String           @id @default(uuid()) @db.Uuid
  threadId  String           @map("thread_id") @db.Uuid
  sender    AssistantSender
  content   String
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  thread    AssistantThread  @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
  @@map("assistant_messages")
}

model Advisor {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  bio          String?
  timezone     String
  specialties  String[]
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  slots        AdvisorSlot[]
  appointments AdvisorAppointment[]

  @@map("advisors")
}

model AdvisorSlot {
  id            String            @id @default(uuid()) @db.Uuid
  advisorId     String            @map("advisor_id") @db.Uuid
  startAt       DateTime          @map("start_at") @db.Timestamptz(6)
  endAt         DateTime          @map("end_at") @db.Timestamptz(6)
  status        String
  heldByUserId  String?           @map("held_by_user_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  advisor       Advisor           @relation(fields: [advisorId], references: [id])
  heldByUser    User?             @relation("AdvisorSlotHeldBy", fields: [heldByUserId], references: [id])
  appointment   AdvisorAppointment?

  @@index([advisorId, startAt])
  @@map("advisor_slots")
}

model AdvisorAppointment {
  id        String      @id @default(uuid()) @db.Uuid
  advisorId String      @map("advisor_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  slotId    String      @unique @map("slot_id") @db.Uuid
  status    String
  notes     String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  advisor   Advisor     @relation(fields: [advisorId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
  slot      AdvisorSlot @relation(fields: [slotId], references: [id])

  @@index([userId, createdAt])
  @@map("advisor_appointments")
}

model Referral {
  id          String          @id @default(uuid()) @db.Uuid
  ownerUserId String          @map("owner_user_id") @db.Uuid
  code        String          @unique
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  owner       User            @relation("ReferralOwner", fields: [ownerUserId], references: [id])
  events      ReferralEvent[]

  @@map("referrals")
}

model ReferralEvent {
  id         String            @id @default(uuid()) @db.Uuid
  referralId String            @map("referral_id") @db.Uuid
  eventType  ReferralEventType @map("event_type")
  meta       Json?
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  referral   Referral          @relation(fields: [referralId], references: [id])

  @@index([referralId, createdAt])
  @@map("referral_events")
}

model UserDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  platform   String
  pushToken  String?  @map("push_token")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id])

  @@unique([pushToken])
  @@index([userId])
  @@map("user_devices")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model WatchlistItem {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  portfolioId String           @map("portfolio_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User             @relation(fields: [userId], references: [id])
  portfolio   CuratedPortfolio @relation(fields: [portfolioId], references: [id])

  @@unique([userId, portfolioId])
  @@index([userId, createdAt])
  @@map("watchlist_items")
}
